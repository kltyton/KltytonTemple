#set($END_BLOCK = ']]#')
#[[apply from: file('../../gradle/target-conventions/base.gradle')

minecraft {
    mappings channel: 'official', version: minecraft_version
    copyIdeResources = true
    runs {
        configureEach {
            workingDirectory project.file('run')
            mods { "${mod_id}" { source sourceSets.main } }
        }
        client {}
        server { args '--nogui' }
        data {
            args '--mod', mod_id, '--all', '--output', file('src/generated/resources').absolutePath,
                    '--existing', file('src/main/resources').absolutePath
        }
    }
}
dependencies { minecraft "net.minecraftforge:forge:${minecraft_version}-${loader_version}" }
tasks.named('jar') { finalizedBy 'reobfJar' }
apply from: file('../../gradle/target-conventions/publish.gradle')
]]#