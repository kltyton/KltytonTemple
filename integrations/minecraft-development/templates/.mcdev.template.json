{
    "version": 3,
    "label": "KltytonTemple",
    "group": "mod",
    "properties": [
        {
            "name": "BUILD_COORDS",
            "type": "build_system_coordinates",
            "order": 10
        },
        {
            "name": "MOD_ID",
            "type": "string",
            "label": "Mod ID",
            "default": "my_mod",
            "validator": "[a-z][a-z0-9_]{1,63}",
            "derives": {
                "parents": [
                    "PROJECT_NAME"
                ],
                "method": "replace",
                "parameters": {
                    "regex": "[^a-z0-9_]+",
                    "replacement": "_",
                    "lowercase": true,
                    "maxLength": 64
                }
            }
        },
        {
            "name": "MOD_NAME",
            "type": "string",
            "label": "Mod \u540d\u79f0",
            "inheritFrom": "PROJECT_NAME",
            "default": "My Mod"
        },
        {
            "name": "TARGET_PROFILE",
            "type": "string",
            "label": "\u7248\u672c\u4e0e\u52a0\u8f7d\u5668",
            "options": {
                "all": "\u5168\u90e8\u7248\u672c\u4e0e\u52a0\u8f7d\u5668",
                "mc1201": "fabric-1.20.1 + forge-1.20.1",
                "mc1211": "fabric-1.21.1 + neoforge-1.21.1",
                "mc2612": "fabric-26.1.2 + neoforge-26.1.2",
                "fabric-1.20.1": "fabric-1.20.1",
                "fabric-1.21.1": "fabric-1.21.1",
                "fabric-26.1.2": "fabric-26.1.2",
                "forge-1.18.2": "forge-1.18.2",
                "forge-1.19.2": "forge-1.19.2",
                "forge-1.20.1": "forge-1.20.1",
                "neoforge-1.21.1": "neoforge-1.21.1",
                "neoforge-26.1.2": "neoforge-26.1.2",
                "neoforge-26.2.0": "neoforge-26.2.0"
            },
            "default": "all",
            "forceDropdown": true
        },
        {
            "name": "AUTHORS",
            "type": "string",
            "label": "\u4f5c\u8005",
            "default": "kltyton"
        },
        {
            "name": "LICENSE",
            "type": "string",
            "label": "\u8bb8\u53ef\u8bc1",
            "default": "MIT"
        },
        {
            "name": "DESCRIPTION",
            "type": "string",
            "label": "\u63cf\u8ff0",
            "default": "A Minecraft mod."
        },
        {
            "name": "JDK",
            "type": "jdk",
            "default": 21,
            "order": 20
        }
    ],
